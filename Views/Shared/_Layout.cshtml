<!DOCTYPE html>
@{
    var paginaLogin = ViewData["PaginaLogin"] is true;
}
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaEntradaNotaFiscal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaEntradaNotaFiscal.styles.css" asp-append-version="true" />
</head>
<body class="@(paginaLogin ? "pagina-login" : "")">
    @if (!paginaLogin) {
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand marca-senf" asp-area="" asp-controller="NotasEntradas" asp-action="ListarCapasNotas">
                    <img src="~/images/logo-maranguape.png" asp-append-version="true"
                         class="marca-senf-logo" width="172" height="132" alt="Maranguape" />
                    <span class="marca-senf-nome">Sistema de Entrada de Notas Fiscais</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="NotasEntradas" asp-action="ListarCapasNotas">Notas</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true) {
                            <li class="nav-item d-flex align-items-center">
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                <span class="me-2">@User.Identity.Name</span>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Sair</button>
                            </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    }
    <div class="@(paginaLogin ? "login-container" : ViewData["LayoutAmplo"] is true ? "container-fluid pagina-notas-ampla" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
