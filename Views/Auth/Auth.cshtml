@model SistemaEntradaNotaFiscal.Models.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    ViewData["PaginaLogin"] = true;
}

<section class="login-painel" aria-labelledby="login-titulo">
    <div class="login-identidade">
        <img src="~/images/logo-maranguape.png" asp-append-version="true"
             class="login-logo" width="172" height="132" alt="Maranguape" />
        <h1 id="login-titulo">Sistema de Entrada de Notas Fiscais</h1>
        <p>Acesse com seu usuário e senha do ERP.</p>
    </div>

    <form asp-controller="Auth" asp-action="Auth" asp-route-returnUrl="@ViewData["ReturnUrl"]"
          method="post" id="formLogin" class="login-formulario">
        <div asp-validation-summary="ModelOnly" class="login-erros text-danger small" role="alert"></div>

        <div class="login-grupo">
            <label asp-for="Usuario" class="visually-hidden"></label>
            <div class="login-campo">
                <svg class="login-icone" xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                </svg>
                <input asp-for="Usuario" class="form-control login-input" placeholder="Usuário do ERP"
                       autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required
                       aria-describedby="erro-usuario" />
            </div>
            <span asp-validation-for="Usuario" id="erro-usuario" class="text-danger small"></span>
        </div>

        <div class="login-grupo">
            <label asp-for="Senha" class="visually-hidden"></label>
            <div class="login-campo">
                <svg class="login-icone" xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" />
                </svg>
                <input asp-for="Senha" type="password" class="form-control login-input login-senha"
                       placeholder="Senha" autocomplete="current-password" required aria-describedby="erro-senha" />
                <button type="button" class="login-toggle" id="btnToggleSenha" aria-label="Mostrar senha"
                        aria-controls="Senha" aria-pressed="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" id="btnVerSenha" aria-hidden="true">
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" id="btnOcultarSenha" class="d-none" aria-hidden="true">
                        <path d="m3 3 18 18M10.6 5.1A11 11 0 0 1 12 5c6.5 0 10 7 10 7a20 20 0 0 1-3 3.7M6 6.1A21 21 0 0 0 2 12s3.5 7 10 7a12 12 0 0 0 5.2-1.2M10 10a3 3 0 0 0 4 4" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Senha" id="erro-senha" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn login-acessar" id="btnEntrar">Acessar</button>
    </form>
    <p class="login-assinatura">Maranguape Laticínios</p>
</section>

@section Scripts {
    <script>
        (function () {
            const senha = document.getElementById('Senha');
            const btnToggle = document.getElementById('btnToggleSenha');
            const iconeVer = document.getElementById('btnVerSenha');          // olho aberto
            const iconeOcultar = document.getElementById('btnOcultarSenha');  // olho cortado
            const btnEntrar = document.getElementById('btnEntrar');

            // Mostrar / ocultar a senha digitada
            btnToggle.addEventListener('click', () => {
                const mostrar = senha.type === 'password';
                senha.type = mostrar ? 'text' : 'password';
                iconeVer.classList.toggle('d-none', mostrar);
                iconeOcultar.classList.toggle('d-none', !mostrar);
                btnToggle.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
                btnToggle.setAttribute('aria-pressed', String(mostrar));
            });

            // Evita duplo clique enquanto a requisição está em andamento
            document.getElementById('formLogin').addEventListener('submit', () => {
                btnEntrar.disabled = true;
                btnEntrar.textContent = 'Entrando...';
            });

            // Ao voltar pelo botão "voltar" do navegador, libera o botão novamente
            window.addEventListener('pageshow', () => {
                btnEntrar.disabled = false;
                btnEntrar.textContent = 'Acessar';
            });
        })();
    </script>
}
